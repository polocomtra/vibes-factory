# API
VF_APP_NAME=VibesFactory API
VF_ENVIRONMENT=local
VF_LOG_LEVEL=INFO
VF_DATABASE_URL=postgresql+asyncpg://vibesfactory:vibesfactory@127.0.0.1:15432/vibesfactory
VF_DATABASE_POOL_SIZE=5
VF_DATABASE_MAX_OVERFLOW=10
VF_CORS_ORIGINS=http://localhost:3000
VF_OTEL_SERVICE_NAME=vibesfactory-api
VF_OTEL_CONSOLE_EXPORTER=false
VF_SUPABASE_URL=https://your-project-ref.supabase.co
VF_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VF_SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
VF_SUPABASE_AUTH_TIMEOUT_SECONDS=5
VF_AZURE_OPENAI_API_KEY=your_azure_openai_api_key
VF_AZURE_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
VF_AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-luna

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Local database / cache
POSTGRES_DB=vibesfactory
POSTGRES_USER=vibesfactory
POSTGRES_PASSWORD=vibesfactory
REDIS_URL=redis://localhost:6379/0
